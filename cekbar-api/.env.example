# Database
DATABASE_URL=mysql://user:password@localhost:3306/cekbar

# App
APP_URL=http://localhost:3000
SESSION_SECRET=your-session-secret-min-32-chars-here
JWT_SECRET=your-jwt-secret-min-32-chars-here

# CEIRID API
CEIRID_API_URL=https://api.ceirid.com
CEIRID_API_KEY=your-ceirid-api-key
CEIRID_WEBHOOK_SECRET=your-ceirid-webhook-secret

# GoPay API
GOPAY_API_URL=https://api.gopay.com
GOPAY_API_KEY=your-gopay-api-key

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Cekbar <noreply@cekbar.com>

# Cron (optional)
CRON_SECRET=your-cron-secret

# Rust logging
RUST_LOG=info

